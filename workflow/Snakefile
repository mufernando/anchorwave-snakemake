"""
AnchorWave Snakemake pipeline
Pairwise alignment of N target genomes to one annotated reference.
"""

configfile: "config/config.yaml"


include: "rules/common.smk"
include: "rules/prep.smk"
include: "rules/align.smk"
include: "rules/qc.smk"


rule all:
    """Request every final output: MAFs, dotplots, and the summary table."""
    input:
        # MAF + fragmented MAF for every target
        expand(
            f"{OUTDIR}/align/{{target}}/{{target}}.maf",
            target=TARGET_NAMES,
        ),
        expand(
            f"{OUTDIR}/align/{{target}}/{{target}}.f.maf",
            target=TARGET_NAMES,
        ),
        # QC dotplots collated into HTML pages
        f"{OUTDIR}/qc/cds_dotplots.html",
        f"{OUTDIR}/qc/index.html",
        f"{OUTDIR}/qc/README.md",
        # Combined summary table
        f"{OUTDIR}/summary.tsv",
    default_target: True


rule dotplots:
    """Stop after minimap2 and plot CDS dotplots, to choose each target's mode before AnchorWave."""
    input:
        f"{OUTDIR}/qc/cds_dotplots.html",
        f"{OUTDIR}/qc/README.md",
